{
  "name": "space-calls",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CallRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Hub"], "deleted_classes": ["CallRoom"] }
  ]
}
