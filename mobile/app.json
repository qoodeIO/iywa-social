{
  "expo": {
    "name": "iywa",
    "slug": "space",
    "scheme": "space",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qoode.space",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "iywa usa la fotocamera per storie e post.",
        "NSPhotoLibraryUsageDescription": "iywa usa le foto per storie, post e prodotti.",
        "NSMicrophoneUsageDescription": "iywa usa il microfono per video e messaggi vocali.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "it",
          "en",
          "es",
          "fr",
          "de",
          "pt",
          "nl",
          "sv",
          "da",
          "nb",
          "fi",
          "pl",
          "cs",
          "sk",
          "hu",
          "ro",
          "hr",
          "el",
          "tr",
          "ru",
          "uk",
          "ar",
          "he",
          "hi",
          "id",
          "ms",
          "th",
          "vi",
          "ja",
          "ko",
          "zh-Hans",
          "zh-Hant"
        ],
        "CFBundleDevelopmentRegion": "it"
      }
    },
    "android": {
      "package": "com.qoode.space",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-video",
      "expo-audio",
      "expo-sharing",
      "@config-plugins/react-native-webrtc",
      [
        "expo-camera",
        {
          "cameraPermission": "iywa usa la fotocamera per storie, reel e videochiamate.",
          "microphonePermission": "iywa usa il microfono per video, chiamate e messaggi vocali.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "iywa usa le foto per storie, post e prodotti."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "iywa usa le foto per storie, post e prodotti.",
          "savePhotosPermission": "iywa salva le tue storie nella libreria."
        }
      ],
      "expo-asset",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "hubUrl": "wss://space-calls.qoode-dev.workers.dev/calls/hub",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "73488b6a-3a9a-47ac-a9fe-02b7e537a852"
      },
      "supportsRTL": true
    },
    "owner": "qoode"
  }
}
